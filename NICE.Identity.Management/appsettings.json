{
  "FrontendProxy": {
    "Routes": {
      "frontend-route": {
        "ClusterId": "frontend-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "frontend-cluster": {
        "Destinations": {
          "frontend-server": {
            "Address": "http://localhost:5000/"
          }
        }
      }
    }
  },
  "Logging": {
    "Application": "IdentityManagement",
    "Environment": "local",
    "RabbitMQHost": "",
    "RabbitMQVHost": "",
    "RabbitMQPort": "",
    "RabbitMQUsername": "",
    "RabbitMQPassword": "",
    "RabbitMQExchangeName": "logging.application.serilog",
    "RabbitMQExchangeType": "topic",
    "SerilogFilePath": "Serilog-{Date}.json",
    "SerilogMinLevel": "Debug",
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    },
    "UseRabbit": false,
    "UseFile": false
  },
  "AppSettings": {
    "Environment": {
      "HealthCheckPublicAPIEndpoint": ""
    }
  },
  "AllowedHosts": "*",
  "WebAppConfiguration": {
    "ApiIdentifier": "Don't fill these in and commit. these get replaced by octo.",
    "AuthorisationServiceUri": "",
    "ClientId": "",
    "ClientSecret": "",
    "Domain": "",
    "PostLogoutRedirectUri": "",
    "RedirectUri": "",
    "GoogleTrackingId": "",
    "RedisServiceConfiguration": {
      "ConnectionString": "",
      "Enabled": false
    }
  },
  "Environment": {
    "Name": "local",
    "HealthCheckPublicAPIEndpoint": "healthcheckapi-local",
    "HealthCheckAuthenticatedEndpoints": [ "https://localhost/healthcheckapi-private" ],
    "HealthCheckAuthenticatedAPIKey": "local_only_api_key",
    "CorsOrigin": "https://local-identityadmin.nice.org.uk:44300"
  },
  "HealthChecksUI": {
    "Webhooks": [
      {
        "Name": "",
        "Uri": "",
        "Payload": "",
        "RestoredPayload": ""
      }
    ]
  }
}
